    208           
    209          /*.............Настройка LCD.............*/
    210          //устанавливаем скважность:
    211           LCD_CR1_bit.DUTY1 = 1;/****фактически ****/
   \   000011 7214 5400    BSET      L:0x5400, #0x2
    212           LCD_CR1_bit.DUTY0 = 1;/*количество COM-ов*/
