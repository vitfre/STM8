   \   00001D 721C 5401    BSET      L:0x5401, #0x6
    216           LCD_CR2_bit.PON2 = 1;
   \   000021 721E 5401    BSET      L:0x5401, #0x7
    217           
    218          //прескаллер n = 2 (коэфициэнт деления будет 2^n, F=(F_RTC/2)/2^n)
    219           //LCD_FRQ_bit.PS3 = 0;/****После прескаллера (32768/2)/4=4096****/
    220           //LCD_FRQ_bit.PS2 = 0;/**и дальше проходит через делитель на 16**/
    221           LCD_FRQ_bit.PS1 = 1;/******что и даст в результате 256 Гц******/
   \   000025 721A 5403    BSET      L:0x5403, #0x5
    222           //LCD_FRQ_bit.PS0 = 0;/******частота кадра же равна 256/4 Гц*****/
